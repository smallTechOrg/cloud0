# cloud0 configuration — copy to .env and fill in. .env is gitignored; never commit it.
# Every variable is documented in spec/architecture.md → Environment variables.

# Absolute path to the read-only service-account key, OUTSIDE the repo.
# Leave unset on Cloud Run (the attached service account is used).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/the/repo/sa-key.json

# Required: comma-separated billed project IDs (populates the scope dropdown).
CLOUD0_GCP_PROJECTS=my-project-a,my-project-b

# Optional until Phase 4: billing account for the Budgets API.
CLOUD0_BILLING_ACCOUNT_ID=XXXXXX-XXXXXX-XXXXXX

# Required: fully-qualified project.dataset.table of the detailed (resource-level) billing export.
CLOUD0_BILLING_EXPORT_TABLE=my-project.my_dataset.gcp_billing_export_resource_v1_XXXXXX_XXXXXX_XXXXXX

# Required: project that runs the BigQuery jobs (needs roles/bigquery.jobUser).
CLOUD0_BIGQUERY_PROJECT=my-project

# Listen port (if unset and PORT is set, PORT is used — Cloud Run).
CLOUD0_PORT=8087
# Bind address; the Dockerfile sets 0.0.0.0.
CLOUD0_BIND=127.0.0.1
# SQLite file; the parent directory is created if missing.
CLOUD0_DB_PATH=./data/cloud0.db

# First ISO week shown in the Cost table / covered by Refresh all.
CLOUD0_FIRST_WEEK=2026-W18
# Hours after a week ends (Mon 00:00 UTC) before it is labelled final.
CLOUD0_SETTLE_HOURS=48
# Days added on each side of the usage window for the _PARTITIONTIME filter.
CLOUD0_PARTITION_MARGIN_DAYS=1
# debug | info | warn | error
CLOUD0_LOG_LEVEL=info

# Tests only: a known complete, non-empty week used by smoke and e2e tests.
CLOUD0_SMOKE_WEEK=2026-W42
# Tests only: port Playwright starts the binary on (never collides with CLOUD0_PORT).
CLOUD0_E2E_PORT=8097
