{
  "combiner": "AND",
  "conditions": [
    {
      "conditionThreshold": {
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": [
              "resource.labels.service_name"
            ],
            "perSeriesAligner": "ALIGN_RATE"
          }
        ],
        "comparison": "COMPARISON_GT",
        "denominatorAggregations": [
          {
            "alignmentPeriod": "60s",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": [
              "resource.labels.service_name"
            ],
            "perSeriesAligner": "ALIGN_RATE"
          }
        ],
        "denominatorFilter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\"",
        "duration": "600s",
        "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND metric.labels.response_code_class=\"5xx\"",
        "thresholdValue": 0.02,
        "trigger": {
          "count": 1
        }
      },
      "displayName": "Cloud Run 5xx rate: 5xx share above 2 % for 10 min"
    },
    {
      "conditionThreshold": {
        "aggregations": [
          {
            "alignmentPeriod": "600s",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": [
              "resource.labels.service_name"
            ],
            "perSeriesAligner": "ALIGN_DELTA"
          }
        ],
        "comparison": "COMPARISON_GT",
        "duration": "0s",
        "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\"",
        "thresholdValue": 19,
        "trigger": {
          "count": 1
        }
      },
      "displayName": "Cloud Run 5xx rate: at least 20 requests in 10 min (minimum traffic)"
    }
  ],
  "displayName": "cloud0: Cloud Run 5xx rate",
  "documentation": {
    "content": "The share of HTTP 5xx responses on a Cloud Run service exceeded 2 % for 10 minutes, with at least 20 requests in the last 10 minutes (a minimum-traffic guard so a single failure out of a handful of requests does not page you).\n\nEach service is evaluated separately; services created later are covered automatically. 4xx responses are not counted.\n\n**First look:** open the cloud0 **Errors** tab and use the triage view to see which service, status code and message dominate, then open the sample in **Logs Explorer** (resource type `Cloud Run Revision`, filter on the service named in the incident).",
    "mimeType": "text/markdown"
  },
  "enabled": true,
  "notificationChannels": [
    "projects/proj-a/notificationChannels/1"
  ],
  "severity": "ERROR",
  "userLabels": {
    "cloud0-template": "run_5xx_rate",
